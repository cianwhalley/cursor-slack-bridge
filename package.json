{
  "name": "cursor-slack-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Bolt Socket Mode bridge: Slack ↔ headless Cursor agent CLI on your machine",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenmindhacker/cursor-slack-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/zenmindhacker/cursor-slack-bridge/issues"
  },
  "homepage": "https://github.com/zenmindhacker/cursor-slack-bridge#readme",
  "keywords": ["slack", "cursor", "agent", "bolt", "socket-mode"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "@slack/web-api": "^7.10.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
