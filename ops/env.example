# Per-agent instance env — copy to ~/.config/cursor-slack/<name>.env (mode 600)

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

CURSOR_API_KEY=
AGENT_BIN=/home/cursor-agent/.local/bin/agent
WORKSPACE=/home/cursor-agent/slack-workspace/your-hub
# Pin Slack model (agent --model). Example: cursor-grok-4.5-high-fast
AGENT_MODEL=cursor-grok-4.5-high-fast
SESSION_DB=/home/cursor-agent/.local/share/cursor-slack/main.db

# Who may DM / @mention the bot. Canonical Slack IDs only (U…, C…).
DM_POLICY=allowlist
ALLOWED_USER_IDS=U0123456789
# configured = ALERT_CHANNELS + OPEN_CHANNELS only.
# any = every channel the bot is in (still allowlisted users).
CHANNEL_POLICY=configured
ALERT_CHANNELS=C0123456789
# OPEN_CHANNELS=

TYPING_REACTION=hourglass_flowing_sand
TEXT_CHUNK_LIMIT=3500

# OpenClaw-aligned Slack streaming
STREAMING_MODE=progress
DRAFT_DELAY_SECONDS=0
STATUS_KEEPALIVE_SECONDS=90
MAX_PROGRESS_LINES=8
MAX_LINE_CHARS=120
PROGRESS_LABEL=Working
TOOL_PROGRESS_DETAIL=explain
PROGRESS_COMMAND_TEXT=raw
PROGRESS_COMMENTARY=false

SESSION_TIMEOUT_SECONDS=900
