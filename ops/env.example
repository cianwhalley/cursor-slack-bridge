# Per-agent instance env — copy to ~/.config/cursor-slack/<name>.env (mode 600)

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

CURSOR_API_KEY=
AGENT_BIN=/home/cursor-agent/.local/bin/agent
WORKSPACE=/home/cursor-agent/workspaces/cleo-agent
SESSION_DB=/home/cursor-agent/.local/share/cursor-slack/cleo.db

DM_POLICY=allowlist
ALLOWED_USER_IDS=U07F1909LCQ
# Cleo: any channel the bot is in, allowlisted users only.
# Silas: CHANNEL_POLICY=configured (default) + ALERT_CHANNELS.
CHANNEL_POLICY=any
ALERT_CHANNELS=C07F195GB96
# OPEN_CHANNELS=

TYPING_REACTION=hourglass_flowing_sand
TEXT_CHUNK_LIMIT=3500

# OpenClaw-aligned Slack streaming
STREAMING_MODE=progress
DRAFT_DELAY_SECONDS=0
STATUS_KEEPALIVE_SECONDS=90
MAX_PROGRESS_LINES=8
MAX_LINE_CHARS=120
PROGRESS_LABEL=Working
# agents.defaults.toolProgressDetail
TOOL_PROGRESS_DETAIL=explain
# streaming.progress.commandText (status = label only for shell)
PROGRESS_COMMAND_TEXT=raw
# streaming.progress.commentary
PROGRESS_COMMENTARY=false

SESSION_TIMEOUT_SECONDS=900
